# Copy this file to .env and fill in real values. Never commit .env.
# See app/lib/env.server.ts for validation rules.

# Postgres connection string (Render-managed Postgres in production; any
# local Postgres for development). Prisma's schema.prisma reads this.
DATABASE_URL="postgresql://user:password@localhost:5432/just_shear_production_hub"

# Single custom-app Admin API connection (SRS Section 1.3 change log).
# Generate in Shopify Admin -> Settings -> Apps -> Develop apps.
SHOPIFY_SHOP_DOMAIN="your-store.myshopify.com"
SHOPIFY_ADMIN_API_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Current stable Shopify Admin GraphQL API version. Optional — defaults to
# 2026-07 if unset. Bump quarterly per https://shopify.dev/docs/api/usage/versioning.
SHOPIFY_API_VERSION="2026-07"
# The custom app's API secret key (Shopify Admin -> app -> API credentials),
# NOT the Admin API access token above. Used only to verify webhook HMAC
# signatures.
SHOPIFY_API_SECRET_KEY="shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Cloudflare R2 (object storage adapter) — from the R2 bucket's API token page.
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="just-shear-production-hub"

# Klaviyo private API key — used for profile upsert + custom event tracking
# (customer-facing sends only; staff alerts never go through Klaviyo).
KLAVIYO_API_KEY="pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Staff session cookie signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-character-hex-string-min-32-chars"

# Optional. Sets the seeded dev admin's password (prisma/seed.ts). If unset,
# a random password is generated and printed to the console once, the first
# time the admin account is created. Also read by Playwright e2e tests, so
# set it locally if you want a stable password across reseeds.
DEV_ADMIN_PASSWORD="choose-a-local-dev-password"
